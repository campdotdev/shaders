{
  "name": "@mattermix/shaders-cli",
  "version": "0.18.0",
  "description": "CLI for Shaders — copy-paste components from the registry into your project.",
  "keywords": [
    "cli",
    "components",
    "shaders",
    "scaffold",
    "shadcn",
    "shader"
  ],
  "homepage": "https://github.com/mattermix/shaders#readme",
  "bugs": {
    "url": "https://github.com/mattermix/shaders/issues"
  },
  "license": "MIT",
  "author": "mattermix",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mattermix/shaders.git",
    "directory": "packages/shaders-cli"
  },
  "bin": {
    "shaders-cli": "./dist/index.js"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "esbuild": "^0.27.0"
  },
  "devDependencies": {
    "@mattermix/shaders": "workspace:*",
    "@mattermix/shaders-react": "workspace:*",
    "@shaders/registry": "workspace:*",
    "@shaders/tsconfig": "workspace:*",
    "@types/node": "^22.7.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "playwright": "^1.50.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "playwright": "*"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22"
  }
}
