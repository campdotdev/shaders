{
  "name": "@camp-dev/shaders",
  "version": "0.20.0",
  "description": "React shader components on WebGPU and Three.js TSL: Tier 1 components, ShaderScene, hooks, and the TSL primitives they build on.",
  "keywords": [
    "background",
    "components",
    "gradient",
    "hooks",
    "react",
    "react-three-fiber",
    "shader",
    "shaders",
    "three.js",
    "tsl",
    "webgpu"
  ],
  "homepage": "https://github.com/campdotdev/shaders#readme",
  "bugs": {
    "url": "https://github.com/campdotdev/shaders/issues"
  },
  "license": "MIT",
  "author": "camp-dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/campdotdev/shaders.git",
    "directory": "packages/shaders"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./color": {
      "types": "./dist/color.d.ts",
      "import": "./dist/color.js",
      "require": "./dist/color.cjs"
    },
    "./gamut": {
      "types": "./dist/gamut.d.ts",
      "import": "./dist/gamut.js",
      "require": "./dist/gamut.cjs"
    },
    "./poster": {
      "types": "./dist/poster.d.ts",
      "import": "./dist/poster.js",
      "require": "./dist/poster.cjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "devDependencies": {
    "@shaders/tsconfig": "workspace:*",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.0.0",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^6.0.1",
    "happy-dom": "^15.0.0",
    "react": "^19.0.0",
    "three": "^0.170.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "three": "^0.170.0"
  }
}
