{
  "name": "@lovo/matter",
  "version": "0.4.1",
  "description": "Engine for Matter — TSL primitives, renderer, scheduler. Framework-agnostic.",
  "keywords": [
    "background",
    "components",
    "gradient",
    "react",
    "shader",
    "shaders",
    "three.js",
    "tsl",
    "webgpu"
  ],
  "homepage": "https://github.com/lovo-hq/matter#readme",
  "bugs": {
    "url": "https://github.com/lovo-hq/matter/issues"
  },
  "license": "MIT",
  "author": "lovo-hq",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lovo-hq/matter.git",
    "directory": "packages/matter"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "devDependencies": {
    "@matter/tsconfig": "workspace:*",
    "@types/three": "^0.170.0",
    "happy-dom": "^15.0.0",
    "three": "^0.170.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "three": "^0.170.0"
  }
}
