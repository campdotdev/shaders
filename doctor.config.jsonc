{
  "$schema": "https://react.doctor/schema/config.json",
  "rules": {
    // Disabled 2026-08-11 after a full triage: all 22 hits were false
    // positives. The detector matches method NAMES (`on`, `sub`, `subscribe`)
    // and cannot see that (a) the signal protocol's `on()` returns an
    // unsubscribe which every flagged effect returns, (b) ShaderScene and
    // useResize register disposal in a deferred cleanup closure because
    // renderer init is async (the repo's Strict-Mode pattern), and (c) TSL's
    // `.sub()` is vector subtraction, not a subscription. Re-enable and
    // re-verify if the detector moves beyond name matching.
    "react-doctor/effect-needs-cleanup": "off",
    // Disabled 2026-08-11 during the warnings triage: all 3 hits were
    // filter().map() over the docs content pipeline's page list — build-time
    // transforms over tens of items, where fusing the passes trades the
    // repo's clarity-first idiom for nothing measurable. Re-evaluate if a
    // genuinely large JS data path ever appears (GPU-side loops don't count;
    // they're TSL, not array methods).
    "react-doctor/js-combine-iterations": "off",
    // Disabled 2026-08-11 during the warnings triage: all 10 hits were false
    // positives. Every flagged material IS disposed in its own effect's
    // cleanup, but the dispose call sits inside a try/catch (three/webgpu can
    // throw during dispose under Strict Mode double-invoke — see any registry
    // shader's cleanup) and the detector cannot prove cleanup through the
    // try block. That try/catch is the repo-wide mandated pattern, so every
    // future shader would re-trigger the same false positive. Re-enable and
    // re-verify if the detector learns to look inside try statements.
    "react-doctor/three-require-owned-material-cleanup": "off",
  },
}
