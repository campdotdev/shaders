    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "${configDir}/dist",
    "tsBuildInfoFile": "${configDir}/.tsbuildinfo"
  },
  "include": ["${configDir}/src"]
}
