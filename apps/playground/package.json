{
  "name": "@matter/playground",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "tsc --noEmit && vp build",
    "preview": "vp preview",
    "typecheck": "tsc --noEmit",
