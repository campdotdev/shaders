{
  // Relative extends (rather than "@matter/tsconfig/base.json" like the
  // other workspaces) because fallow's resolver does not follow tsconfig
  // `extends` through workspace packages, which causes it to drop this
  // file's `paths` and flag every `@/*` import as unresolved.
  "extends": "../../tooling/tsconfig/base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "noEmit": true,
    "incremental": false,
    "moduleResolution": "Bundler",
    "module": "ESNext",
    "jsx": "preserve",
    "allowJs": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": false,
    "paths": {
      "@/*": ["./src/*"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": ["src", "css.d.ts", "next-env.d.ts", "next.config.ts", ".next/types/**/*.ts"]
}
