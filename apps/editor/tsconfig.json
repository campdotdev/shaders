{
  "extends": "../../tooling/tsconfig/base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "noEmit": true,
    "incremental": false,
    "moduleResolution": "Bundler",
    "module": "ESNext",
    "jsx": "preserve",
    "allowJs": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": false,
    "paths": {
      "@/*": ["./src/*"],
      "@camp-dev/shaders": ["../../packages/shaders/src/index.ts"],
      "@camp-dev/shaders/color": ["../../packages/shaders/src/color.ts"],
      "@camp-dev/shaders/gamut": ["../../packages/shaders/src/gamut.ts"],
      "@camp-dev/shaders/poster": ["../../packages/shaders/src/poster.ts"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": ["src", "next-env.d.ts", "next.config.ts", ".next/types/**/*.ts"]
}
