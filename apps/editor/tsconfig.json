{
  "extends": "../../tooling/tsconfig/base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "noEmit": true,
    "incremental": false,
    "moduleResolution": "Bundler",
    "module": "ESNext",
    "jsx": "preserve",
    "allowJs": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": false,
    "paths": {
      "@/*": ["./src/*"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": ["src", "next-env.d.ts", "next.config.ts", ".next/types/**/*.ts"]
}
